!node_modules/kuzu/*.mjs
!node_modules/kuzu/*.node
!node_modules/kuzu/package.json
!node_modules/kuzu/LICENSE
*.md
esbuild.mjs
eslint.config.mjs
tsconfig.json
vitest.config.ts
src/
