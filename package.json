{
  "name": "gizem",
  "version": "0.2.0",
  "description": "Derived code-graph index + architectural rule engine for AI coding agents",
  "license": "MIT",
  "author": "Mustafa Kiyar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkyr/gizem"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.101.0"
  },
  "main": "dist/extension.js",
  "bin": {
    "gizem": "dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gizem.reindex",
        "title": "GIZEM: Re-index Workspace"
      },
      {
        "command": "gizem.findSymbol",
        "title": "GIZEM: Find Symbol"
      },
      {
        "command": "gizem.checkRules",
        "title": "GIZEM: Check Rules"
      }
    ],
    "configuration": {
      "title": "GIZEM",
      "properties": {
        "gizem.disabledTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "MCP tool names to not register (e.g. \"analyze\")."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "fetch-grammars": "node scripts/fetch-grammars.mjs",
    "sync-lm-tools": "node scripts/sync-lm-tools.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "kuzu": "^0.11.3",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "gpt-tokenizer": "^3.4.0",
    "tree-sitter-wasms": "^0.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.0.0"
  }
}
