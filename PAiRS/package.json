{
  "name": "pairs",
  "displayName": "PAiRS",
  "version": "0.28.0",
  "description": "Code-graph index for AI coding agents: symbol search, call graphs, blast-radius analysis and safe atomic renames — as Copilot tools and a CLI.",
  "publisher": "mkyr",
  "license": "MIT",
  "author": "Mustafa Kiyar",
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "code graph",
    "copilot",
    "language model tools",
    "agent mode",
    "claude code",
    "tree-sitter",
    "code navigation",
    "call graph",
    "impact analysis",
    "refactoring",
    "rename symbol",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akharon/PAiRS.git",
    "directory": "PAiRS"
  },
  "homepage": "https://github.com/akharon/PAiRS/tree/main/PAiRS#readme",
  "bugs": {
    "url": "https://github.com/akharon/PAiRS/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.101.0"
  },
  "main": "dist/extension.js",
  "bin": {
    "pairs": "dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "PAiRS indexes files on the local disk and stores its index in .pairs/."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the diff_impact tool is disabled because it runs git, which honours repository-local configuration. Everything else only reads source files."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pairs.reindex",
        "title": "PAiRS: Re-index Workspace"
      },
      {
        "command": "pairs.rebuildIndex",
        "title": "PAiRS: Rebuild Index From Scratch"
      },
      {
        "command": "pairs.findSymbol",
        "title": "PAiRS: Find Symbol"
      },
      {
        "command": "pairs.moduleMap",
        "title": "PAiRS: Show Module Map"
      }
    ],
    "configuration": {
      "title": "PAiRS",
      "properties": {
        "pairs.disabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "find_symbol",
              "get_symbol",
              "outline",
              "impact",
              "diff_impact",
              "hierarchy",
              "who_calls",
              "file_deps",
              "module_map",
              "analyze",
              "rename_symbol",
              "grep_symbols",
              "context_pack"
            ]
          },
          "default": [],
          "description": "Tool names to not register as in-editor Language Model Tools, e.g. \"analyze\"."
        },
        "pairs.skillLocation": {
          "type": "string",
          "enum": [
            "user",
            "workspace",
            "off"
          ],
          "enumDescriptions": [
            "Write the Claude Code skill once to ~/.claude/skills/pairs/SKILL.md (shared by every project and git worktree).",
            "Write the skill into each workspace folder's .claude/skills/pairs/SKILL.md (adds an untracked file to every checkout).",
            "Do not write a Claude Code skill."
          ],
          "default": "user",
          "description": "Where the PAiRS Claude Code skill is installed. The file is only rewritten when its content changes."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "pairs_find_symbol",
        "displayName": "PAiRS: find symbol definition",
        "toolReferenceName": "pairsFindSymbol",
        "modelDescription": "Locate a symbol definition by bare or qualified name, workspace-wide (file:line, kind, signature). Use instead of grep/Read. preview:true adds doc + first body lines. Ambiguous names list candidates.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Bare or qualified name, e.g. \"login\" or \"AuthService::login\"."
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "module",
                  "function",
                  "method",
                  "class",
                  "struct",
                  "interface",
                  "enum",
                  "trait",
                  "impl",
                  "field",
                  "var",
                  "param",
                  "const",
                  "static",
                  "macro"
                ]
              },
              "description": "Restrict to these kinds."
            },
            "langs": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "c",
                  "cpp",
                  "python",
                  "javascript",
                  "typescript",
                  "java",
                  "go",
                  "ruby",
                  "dart",
                  "rust",
                  "css",
                  "html",
                  "gdscript"
                ]
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Skip this many results (paging)."
            },
            "preview": {
              "type": "boolean",
              "description": "Include doc and first body lines per hit."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "pairs_get_symbol",
        "displayName": "PAiRS: get full declaration",
        "toolReferenceName": "pairsGetSymbol",
        "modelDescription": "Full declaration of a symbol: signature, doc, body excerpt, members. Use instead of Read for a symbol's shape.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Bare or qualified name."
            },
            "path": {
              "type": "string",
              "description": "Prefer the symbol defined in this file (path or suffix)."
            },
            "includeMembers": {
              "type": "boolean",
              "description": "List members of a type/impl."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "pairs_outline",
        "displayName": "PAiRS: file outline",
        "toolReferenceName": "pairsOutline",
        "modelDescription": "Symbols of one file with signatures and line numbers, in order. Use instead of Read to see a file's shape.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "pairs_impact",
        "displayName": "PAiRS: change impact (blast radius)",
        "toolReferenceName": "pairsImpact",
        "modelDescription": "Transitive dependants (\"blast radius\") of a symbol: callers, readers, implementers, up to `depth` hops. Call BEFORE renaming/removing/changing a symbol. Fuzzy (name-only) dependants are marked. kinds slices by edge type ([\"CALLS\"] = callers only); includeTests:false drops test-only paths.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Bare or qualified name."
            },
            "path": {
              "type": "string",
              "description": "Prefer the symbol defined in this file (path or suffix)."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "Hops to walk."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "includeTests": {
              "type": "boolean",
              "description": "Include dependants reached only via test files."
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "CALLS",
                  "READS",
                  "WRITES",
                  "IMPLEMENTS",
                  "EXTENDS",
                  "REFERENCES"
                ]
              },
              "description": "Only these edge kinds, e.g. [\"READS\",\"WRITES\"]. Omit for all."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "pairs_diff_impact",
        "displayName": "PAiRS: impact of the current diff",
        "toolReferenceName": "pairsDiffImpact",
        "modelDescription": "Blast radius of the current git change in one merged walk: maps diff hunks to changed symbols, then their dependants (each listed once). Use instead of reading the diff and calling impact per function. Hunks outside any symbol are listed separately. Default: unstaged tree; rev for e.g. \"main...HEAD\".",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "rev": {
              "type": "string",
              "description": "Git revision/range, e.g. \"HEAD\" or \"main...HEAD\". Omit for working-tree changes."
            },
            "staged": {
              "type": "boolean",
              "description": "Diff the index instead (ignored when rev is set)."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "Hops from each changed symbol."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Skip this many results (paging)."
            },
            "includeTests": {
              "type": "boolean",
              "description": "Include dependants reached only via test files."
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "CALLS",
                  "READS",
                  "WRITES",
                  "IMPLEMENTS",
                  "EXTENDS",
                  "REFERENCES"
                ]
              },
              "description": "Only these edge kinds. Omit for all."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          }
        }
      },
      {
        "name": "pairs_hierarchy",
        "displayName": "PAiRS: inheritance hierarchy",
        "toolReferenceName": "pairsHierarchy",
        "modelDescription": "Type tree: ancestors (extends/implements) and descendants, `depth` hops each way. Use before changing a base class/interface. Narrower than impact.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Bare or qualified class/interface/trait name."
            },
            "path": {
              "type": "string",
              "description": "Prefer the symbol defined in this file (path or suffix)."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "Hops each direction."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "pairs_who_calls",
        "displayName": "PAiRS: call graph (callers/callees)",
        "toolReferenceName": "pairsWhoCalls",
        "modelDescription": "Direct callers (or callees) of a function/method, one hop; cheaper than impact. includeTests:false hides test-file edges (footer says how many).",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "description": "Prefer the symbol defined in this file (path or suffix)."
            },
            "direction": {
              "type": "string",
              "enum": [
                "callers",
                "callees"
              ]
            },
            "includeFuzzy": {
              "type": "boolean",
              "description": "Include name-match (unverified) edges."
            },
            "includeTests": {
              "type": "boolean",
              "description": "Include edges from test files."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "pairs_file_deps",
        "displayName": "PAiRS: file dependencies",
        "toolReferenceName": "pairsFileDeps",
        "modelDescription": "File-level dependencies: importers (what breaks if this file changes or moves) or imports. Use before moving/deleting a file.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path."
            },
            "direction": {
              "type": "string",
              "enum": [
                "importers",
                "imports"
              ]
            },
            "transitive": {
              "type": "boolean",
              "description": "Walk up to 5 hops; results carry depth."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "pairs_module_map",
        "displayName": "PAiRS: module map (subsystems)",
        "toolReferenceName": "pairsModuleMap",
        "modelDescription": "Directory-level architecture: subsystems, module cycles, dependency layers, fan-in/out, and drift between folder layout and real dependencies. Use for \"where does this belong\", \"what is safe to change\", big refactors. boundary drills into one edge.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max items per list (drift edges, cycles)."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Collapse modules to N leading path segments (large monorepos)."
            },
            "resolution": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10,
              "description": "Louvain resolution: >1 more/smaller subsystems."
            },
            "boundary": {
              "type": "string",
              "description": "\"<from module> -> <to module>\" (keys from a plain call): the target symbols the source uses, with sites."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          }
        }
      },
      {
        "name": "pairs_analyze",
        "displayName": "PAiRS: analyze (dead code, cycles, hotspots)",
        "toolReferenceName": "pairsAnalyze",
        "modelDescription": "Workspace analyses by `kind`: dead_code (zero-reference candidates), fan_out (most outgoing calls), cycles (module/type), test_gap (exported symbols no test references).",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "dead_code",
                "fan_out",
                "cycles",
                "test_gap"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "module",
                "type"
              ],
              "description": "cycles only."
            },
            "pathPrefix": {
              "type": "string",
              "description": "Only files under this directory."
            },
            "excludePath": {
              "type": "string",
              "description": "Skip files under this directory."
            },
            "includeExported": {
              "type": "boolean",
              "description": "dead_code: also exported symbols."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Skip this many results (paging)."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "pairs_rename_symbol",
        "displayName": "PAiRS: rename symbol",
        "toolReferenceName": "pairsRenameSymbol",
        "modelDescription": "Rename a symbol and all its reference sites in one pass. Aborts without writing if any site cannot be matched safely or is fuzzy (unless includeFuzzy). No undo log: revert via VCS.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Bare or qualified name."
            },
            "newName": {
              "type": "string",
              "description": "New bare identifier."
            },
            "path": {
              "type": "string",
              "description": "Prefer the symbol defined in this file (path or suffix)."
            },
            "includeFuzzy": {
              "type": "boolean",
              "description": "Also rename name-only (fuzzy) sites; may hit unrelated same-named symbols."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "name",
            "newName"
          ]
        }
      },
      {
        "name": "pairs_grep_symbols",
        "displayName": "PAiRS: search symbols by regex",
        "toolReferenceName": "pairsGrepSymbols",
        "modelDescription": "Substring or regex search over symbol names, qualified names, signatures and docs; returns file:line citations, not file contents. Use when the exact name is unknown.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Substring, or regex when isRegex."
            },
            "isRegex": {
              "type": "boolean"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "module",
                  "function",
                  "method",
                  "class",
                  "struct",
                  "interface",
                  "enum",
                  "trait",
                  "impl",
                  "field",
                  "var",
                  "param",
                  "const",
                  "static",
                  "macro"
                ]
              },
              "description": "Restrict to these kinds."
            },
            "pathPrefix": {
              "type": "string",
              "description": "Only files under this directory."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          },
          "required": [
            "pattern"
          ]
        }
      },
      {
        "name": "pairs_context_pack",
        "displayName": "PAiRS: context pack (bundle)",
        "toolReferenceName": "pairsContextPack",
        "modelDescription": "One call bundling a symbol's or file's definition, callers, callees, type hierarchy and module deps. Use instead of several separate calls.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Symbol name. Give this or `path`."
            },
            "path": {
              "type": "string",
              "description": "Workspace-relative file path. Give this or `name`."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max items per section."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Workspace folder name when several are open; default first."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "build:watch": "node esbuild.mjs --watch",
    "fetch-grammars": "node scripts/fetch-grammars.mjs",
    "sync-lm-tools": "node scripts/sync-lm-tools.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/akharon/PAiRS/blob/main/PAiRS --baseImagesUrl https://github.com/akharon/PAiRS/raw/main/PAiRS",
    "install:vscode": "bash scripts/install.sh",
    "link-cli": "node scripts/link-cli.mjs",
    "unlink-cli": "node scripts/unlink-cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "gpt-tokenizer": "^4.1.2",
    "sharp": "^0.35.3",
    "tree-sitter-cli": "^0.27.0",
    "tree-sitter-gdscript": "^6.1.0",
    "tree-sitter-wasms": "^0.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^5.1.1",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  }
}
