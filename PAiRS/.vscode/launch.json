{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build:dev"
    },
    {
      "name": "Build release .vsix",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run package",
      "cwd": "${workspaceFolder}"
    }
  ]
}
